# ==========================================
# AlphaZero Gomoku v7 — .gitignore
# ==========================================

# --- Python 快取 ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- 訓練產物（模型權重太大，不適合上傳 Git）---
checkpoints/
*.pth

# --- TensorBoard 日誌 ---
logs/

# --- Worker 崩潰日誌 ---
worker_crash_*.log

# --- Numba JIT 快取 ---
__numba_cache__/

# --- 系統垃圾檔 ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE 設定 ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 虛擬環境 ---
venv/
.venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/

# --- 分發打包 ---
dist/
build/
*.egg-info/

# --- 測試與日誌產物 ---
checkpoints_test/
*.log
